<% layout('layouts/boilerplate') %>
    <div id="cluster-map" style="width: 100%; height: 500px"></div>
    <h1>スパ一覧</h1>
    <div>
        <a href="/spagrounds/new">新規登録</a>
    </div>

    <% for(let spaground of spagrounds) { %>
        <div class="card mb-3">
            <div class="row">
                <div class="col-md-4">
                    <img class="img-fluid" src="<%= spaground.images[0].url %>" alt="">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= spaground.title %>
                        </h5>
                        <p class="card-text">
                            <%= spaground.description %>
                        </p>
                        <p class="card-text">
                            <small class="text-muted">
                                <%= spaground.location %>
                            </small>
                        </p>
                        <a class="btn btn-primary" href="/spagrounds/<%= spaground._id %>">
                            <%= spaground.title %>の詳細
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>


            <script>
                const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
                const spagrounds = {
                    type: "FeatureCollection",
                    features: <%- JSON.stringify(
                        spagrounds.map(spaground => ({
                            type: "Feature",
                            geometry: spaground.geometry,
                            properties: { popupMarkup: spaground?.properties?.popupMarkup }
                        }))
                    ) %>
                };
            </script>

            <script src="/javascripts/clusterMap.js"></script>